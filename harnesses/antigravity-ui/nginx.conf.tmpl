# Forwarding proxy for the antigravity-ui harness.
#
# Rendered by agui_helper.py (render-nginx) at agent start. Only the
# dollar-brace placeholders below are substituted; nginx variables ($name, no
# braces) are left alone. The upstream is the app's language server on
# loopback; this server listens on loopback only and is the one port the
# harness exposes.
worker_processes 1;
daemon off;
pid ${STATE}/nginx.pid;
error_log ${STATE}/nginx.err warn;

events {
  worker_connections 256;
}

http {
  access_log off;
  client_body_temp_path ${STATE}/nx-body;
  proxy_temp_path ${STATE}/nx-proxy;
  fastcgi_temp_path ${STATE}/nx-fastcgi;
  uwsgi_temp_path ${STATE}/nx-uwsgi;
  scgi_temp_path ${STATE}/nx-scgi;
  client_max_body_size 64m;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  server {
    listen 127.0.0.1:${AGUI_PROXY_PORT};

    location / {
      proxy_pass https://127.0.0.1:${JETSKI_LS_PORT};
      # Loopback upstream with the language server's self-signed certificate.
      proxy_ssl_verify off;
      proxy_http_version 1.1;
      proxy_set_header Host 127.0.0.1:${JETSKI_LS_PORT};
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      # Plain upstream bodies, so sub_filter (when enabled) sees text.
      proxy_set_header Accept-Encoding "";
      proxy_buffering off;
      proxy_read_timeout 1h;
      proxy_send_timeout 1h;
${PATH_REWRITE_RULES}
    }
  }
}
