#!/usr/bin/env bash
# scripts/single-node-vm/tests/lib/gcloud — a fake `gcloud` for the
# hybrid-tier test harness, put first on PATH by tests/run.sh. Never
# contacts GCP.
#
# Every invocation is appended to $GCLOUD_STUB_LOG, one call per line
# (space-joined argv), so tests can assert on exactly what hybrid-tier.sh
# or deploy.sh asked gcloud to do. Responses are served from plain files
# under $GCLOUD_STUB_STATE_DIR, which each test populates as its fixture
# and can inspect afterwards to see what would have been created or
# deleted.
#
# Covers both the hybrid-tier functions (firewall rules, clusters,
# instance groups/templates) and the base deploy.sh resources needed to
# run deploy.sh itself end to end against this stub (service account,
# router, NAT, the base VM, Cloud Run delete, auth/project plumbing).
# Firewall rules and clusters are stored as JSON (mirroring the real
# --format=json shape hybrid-tier.sh parses); instance-group/template
# lookups are stored as plain-text fixtures keyed by the last path
# segment of whatever URL or name was passed in.
#
# --project and --zone are required on every call that takes them in the
# real gcloud CLI; this stub asserts they're present (and non-empty)
# everywhere hybrid-tier.sh or deploy.sh is expected to pass them --
# --project on every create/list/delete/describe, --zone on every
# per-instance call -- and fails loudly (not just "not found") if one is
# missing, rather than silently falling back to an ambient default the
# way real gcloud would.

set -euo pipefail

: "${GCLOUD_STUB_LOG:?GCLOUD_STUB_LOG must be set}"
: "${GCLOUD_STUB_STATE_DIR:?GCLOUD_STUB_STATE_DIR must be set}"

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Deliberately its own variable, not "${PYTHON:-python3}": a test that
# sets PYTHON for deploy.sh's own process (to simulate a missing
# interpreter) exports it to every child process deploy.sh execs,
# including this stub -- which needs a real interpreter for its own JSON
# handling regardless of what deploy.sh is being tested against.
PYTHON="${GCLOUD_STUB_PYTHON:-python3}"

mkdir -p "${GCLOUD_STUB_STATE_DIR}/firewall-rules" "${GCLOUD_STUB_STATE_DIR}/clusters" \
  "${GCLOUD_STUB_STATE_DIR}/migs" "${GCLOUD_STUB_STATE_DIR}/templates" \
  "${GCLOUD_STUB_STATE_DIR}/instances" "${GCLOUD_STUB_STATE_DIR}/subnets" "${GCLOUD_STUB_STATE_DIR}/run-services"

printf '%s\n' "$*" >> "$GCLOUD_STUB_LOG"

# get_flag KEY "$@" — echoes the value of --KEY=VALUE among the remaining
# args, or fails (no output) if absent.
get_flag() {
  local key="$1"
  shift
  local a
  for a in "$@"; do
    case "$a" in
      "--${key}="*) printf '%s' "${a#--"${key}"=}"; return 0 ;;
    esac
  done
  return 1
}

# require_flag KEY "$@" — fails loudly if --KEY=... is missing or empty.
require_flag() {
  local key="$1"
  shift
  local v
  v="$(get_flag "$key" "$@")" || {
    echo "gcloud-stub: missing --${key} on: $*" >&2
    exit 1
  }
  if [[ -z "$v" ]]; then
    echo "gcloud-stub: empty --${key} on: $*" >&2
    exit 1
  fi
}

# require_project "$@" — fails loudly if --project=... is missing or empty.
require_project() {
  require_flag project "$@"
}

# last_segment URL_OR_NAME — the basename, used as the fixture lookup key
# for instance groups and instance templates regardless of whether
# hybrid-tier.sh passed a bare name or a full self-link URL.
last_segment() {
  printf '%s' "${1##*/}"
}

# "instance-groups managed describe" and "routers nats <verb>" are
# four-word subcommands (unlike every other case below, which is three
# words plus a resource name at $4, or two words plus a name/project at
# $3), so they need their own match on $1..$4 before the general dispatch.
case "${1:-} ${2:-} ${3:-} ${4:-}" in
  "compute instance-groups managed describe")
    key="$(last_segment "${5:-}")"
    f="${GCLOUD_STUB_STATE_DIR}/migs/${key}.txt"
    if [[ -f "$f" ]]; then
      cat "$f"
      exit 0
    fi
    echo "gcloud-stub: managed instance group ${key} not found" >&2
    exit 1
    ;;
  "compute networks subnets describe")
    require_project "$@"
    require_flag region "$@"
    key="$(last_segment "${5:-}")"
    f="${GCLOUD_STUB_STATE_DIR}/subnets/${key}.json"
    if [[ -f "${f}.describe-fail" ]]; then
      echo "gcloud-stub: simulated describe failure for subnet ${key}" >&2
      exit 1
    fi
    if [[ -f "$f" ]]; then
      cat "$f"
      exit 0
    fi
    # No explicit fixture: every cluster fixture (seed_cluster) implicitly
    # names its subnet "default-subnet", so tests that don't care about
    # the actual CIDR value don't need to seed one explicitly.
    echo '{"ipCidrRange": "10.128.0.0/20"}'
    exit 0
    ;;
  "compute routers nats describe")
    exit 1
    ;;
  "compute routers nats create")
    require_project "$@"
    exit 0
    ;;
  "compute routers nats delete")
    exit 0
    ;;
esac

case "${1:-} ${2:-}" in
  "projects add-iam-policy-binding")
    exit 0
    ;;
  "projects get-ancestors")
    # Empty output = "could not read ancestry" in deploy.sh, which just
    # skips the cross-org IAP check. Not the scenario under test here.
    exit 0
    ;;
  "services enable")
    require_project "$@"
    exit 0
    ;;
  "services list")
    require_project "$@"
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/services-list-should-fail" ]]; then
      echo "gcloud-stub: simulated services list failure" >&2
      exit 1
    fi
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/enabled-apis.txt" ]]; then
      cat "${GCLOUD_STUB_STATE_DIR}/enabled-apis.txt"
    else
      # Default: every API this script could ever require is already
      # enabled, so a test that doesn't care about the API check sees no
      # `services enable` call at all.
      cat <<'APIS'
compute.googleapis.com
run.googleapis.com
iap.googleapis.com
cloudbuild.googleapis.com
artifactregistry.googleapis.com
container.googleapis.com
APIS
    fi
    exit 0
    ;;
  "auth list")
    echo "stub-deployer@example.com"
    exit 0
    ;;
esac

case "${1:-} ${2:-} ${3:-}" in
  "container clusters get-credentials")
    require_project "$@"
    get_flag location "$@" >/dev/null || {
      echo "gcloud-stub: missing --location on: $*" >&2
      exit 1
    }
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/get-credentials-should-fail" ]]; then
      echo "gcloud-stub: simulated get-credentials failure" >&2
      exit 1
    fi
    : "${KUBECONFIG:?KUBECONFIG must be set when calling get-credentials}"
    echo "fake-kubeconfig-for-${4:-}" > "$KUBECONFIG"
    exit 0
    ;;
  "config get-value project")
    # Only the interactive path (no --config) asks for this: PROJECT_ID
    # otherwise comes straight from the config file.
    echo "demo-project"
    exit 0
    ;;
  "compute firewall-rules describe")
    require_project "$@"
    name="${4:-}"
    f="${GCLOUD_STUB_STATE_DIR}/firewall-rules/${name}.json"
    if [[ -f "$f" ]]; then
      cat "$f"
      exit 0
    fi
    exit 1
    ;;
  "compute firewall-rules create")
    require_project "$@"
    name="${4:-}"
    desc="$(get_flag description "$@")" || desc=""
    network="$(get_flag network "$@")" || network=""
    direction="$(get_flag direction "$@")" || direction=""
    action="$(get_flag action "$@")" || action=""
    rules="$(get_flag rules "$@")" || rules=""
    source_tags="$(get_flag source-tags "$@")" || source_tags=""
    source_ranges="$(get_flag source-ranges "$@")" || source_ranges=""
    target_tags="$(get_flag target-tags "$@")" || target_tags=""
    priority="$(get_flag priority "$@")" || priority=""

    proto="${rules%%:*}"
    if [[ "$proto" == "$rules" ]]; then
      ports=""
    else
      ports="${rules#*:}"
    fi

    "$PYTHON" "${LIB_DIR}/firewall-rule-json.py" \
      "$desc" "$network" "$direction" "$action" "$proto" "$ports" \
      "$source_tags" "$source_ranges" "$target_tags" "$priority" \
      > "${GCLOUD_STUB_STATE_DIR}/firewall-rules/${name}.json"
    exit 0
    ;;
  "compute firewall-rules delete")
    require_project "$@"
    name="${4:-}"
    f="${GCLOUD_STUB_STATE_DIR}/firewall-rules/${name}.json"
    if [[ -f "${f}.delete-fail" ]]; then
      echo "gcloud-stub: simulated delete failure for ${name}" >&2
      exit 1
    fi
    if [[ -f "$f" ]]; then
      rm -f "$f"
      exit 0
    fi
    echo "gcloud-stub: firewall rule ${name} not found" >&2
    exit 1
    ;;
  "compute firewall-rules list")
    require_project "$@"
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/firewall-rules-list-should-fail" ]]; then
      echo "gcloud-stub: simulated list failure (permission denied)" >&2
      exit 1
    fi
    filter="$(get_flag filter "$@")" || filter=""
    inner="${filter#name=(}"
    inner="${inner%)}"
    "$PYTHON" -c "
import json, os, sys
names = sys.argv[1].split()
state_dir = sys.argv[2]
out = []
for n in names:
    p = os.path.join(state_dir, 'firewall-rules', n + '.json')
    if os.path.isfile(p):
        with open(p) as f:
            d = json.load(f)
        d['name'] = n
        out.append(d)
print(json.dumps(out))
" "$inner" "${GCLOUD_STUB_STATE_DIR}"
    exit 0
    ;;
  "compute instances add-tags")
    require_project "$@"
    require_flag zone "$@"
    exit 0
    ;;
  "compute instances list")
    require_project "$@"
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/instances-list-should-fail" ]]; then
      echo "gcloud-stub: simulated transient instances list failure" >&2
      exit 1
    fi
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/instances-list-zone-unreachable" ]]; then
      # Emulates a real AggregatedList (no --zones) hitting an UNREACHABLE
      # zone: with the SDK's default compute/allow_partial_error=true,
      # that's downgraded to a stderr warning and exit 0 with the
      # unreachable zone's instances (including this one) missing from
      # stdout. Only CLOUDSDK_COMPUTE_ALLOW_PARTIAL_ERROR=false makes it a
      # hard error, matching real gcloud.
      echo "gcloud-stub: (simulated) Some requests did not succeed: - Failed to fetch some zones: ('Unreachable')" >&2
      if [[ "${CLOUDSDK_COMPUTE_ALLOW_PARTIAL_ERROR:-}" == "false" ]]; then
        exit 1
      fi
      exit 0
    fi
    filter="$(get_flag filter "$@")" || filter=""
    format="$(get_flag format "$@")" || format=""
    name="${filter#name=}"
    f="${GCLOUD_STUB_STATE_DIR}/instances/${name}"
    if [[ -f "$f" ]]; then
      if [[ "$format" == "value(name)" ]]; then
        echo "$name"
      else
        cat "$f"
      fi
    fi
    exit 0
    ;;
  "compute instances describe")
    require_project "$@"
    require_flag zone "$@"
    name="${4:-}"
    # Same sentinel purpose as the "instances create" case below: this is
    # always the call deploy.sh makes right before branching into either
    # "create a new VM" or "tag the existing one", so it marks the point
    # a create-mode wiring test has seen everything interesting on either
    # branch, whether or not a new VM actually gets created.
    touch "${GCLOUD_STUB_STATE_DIR}/vm-create-happened"
    [[ -f "${GCLOUD_STUB_STATE_DIR}/instances/${name}" ]] && exit 0
    exit 1
    ;;
  "compute instances delete")
    require_project "$@"
    require_flag zone "$@"
    name="${4:-}"
    f="${GCLOUD_STUB_STATE_DIR}/instances/${name}"
    if [[ -f "${f}.delete-fail" ]]; then
      echo "gcloud-stub: simulated delete failure for ${name}" >&2
      exit 1
    fi
    if [[ -f "$f" ]]; then
      rm -f "$f"
      exit 0
    fi
    echo "gcloud-stub: instance ${name} not found" >&2
    exit 1
    ;;
  "compute instances create")
    require_project "$@"
    name="${4:-}"
    echo "us-central1-b" > "${GCLOUD_STUB_STATE_DIR}/instances/${name}"
    # A sentinel the create-mode wiring tests poll for, so they can stop
    # deploy.sh right after VM creation instead of waiting out its SSH
    # retry loop (which this stub's unhandled `compute ssh` case makes
    # fail immediately, but deploy.sh still sleeps between attempts).
    touch "${GCLOUD_STUB_STATE_DIR}/vm-create-happened"
    exit 0
    ;;
  "compute zones list")
    echo "us-central1-b"
    exit 0
    ;;
  "compute routers describe")
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/router-exists" ]]; then
      exit 0
    fi
    exit 1
    ;;
  "compute routers create")
    require_project "$@"
    exit 0
    ;;
  "compute routers delete")
    exit 0
    ;;
  "iam service-accounts describe")
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/service-account-exists" ]]; then
      exit 0
    fi
    exit 1
    ;;
  "iam service-accounts create")
    require_project "$@"
    exit 0
    ;;
  "iam service-accounts delete")
    exit 0
    ;;
  "run services delete")
    exit 0
    ;;
  "run services describe")
    require_project "$@"
    require_flag region "$@"
    name="${4:-}"
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/run-services/${name}.describe-error" ]]; then
      echo "gcloud-stub: PERMISSION_DENIED: simulated PERMISSION_DENIED describe error unrelated to existence" >&2
      exit 1
    fi
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/run-services/${name}.exists" ]]; then
      exit 0
    fi
    echo "gcloud-stub: NOT_FOUND: Requested entity was not found." >&2
    exit 1
    ;;
  "container clusters describe")
    require_project "$@"
    get_flag location "$@" >/dev/null || {
      echo "gcloud-stub: missing --location on: $*" >&2
      exit 1
    }
    name="${4:-}"
    f="${GCLOUD_STUB_STATE_DIR}/clusters/${name}.json"
    if [[ -f "${f}.describe-error" ]]; then
      echo "gcloud-stub: PERMISSION_DENIED: simulated PERMISSION_DENIED cluster describe error unrelated to existence" >&2
      exit 1
    fi
    if [[ -f "$f" ]]; then
      cat "$f"
      exit 0
    fi
    echo "gcloud-stub: NOT_FOUND: Cluster ${name} not found" >&2
    exit 1
    ;;
  "compute instance-templates describe")
    key="$(last_segment "${4:-}")"
    f="${GCLOUD_STUB_STATE_DIR}/templates/${key}.txt"
    if [[ -f "$f" ]]; then
      cat "$f"
      exit 0
    fi
    echo "gcloud-stub: instance template ${key} not found" >&2
    exit 1
    ;;
  *)
    echo "gcloud-stub: unhandled invocation: $*" >&2
    exit 1
    ;;
esac
