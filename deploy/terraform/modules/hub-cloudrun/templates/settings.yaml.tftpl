schema_version: "1"
active_profile: remote
profiles:
  # REQUIRED (tf-review B3, proven via config.LoadGlobalSettings): without
  # this, "remote" resolves to the embedded default 'kubernetes' runtime and
  # the runtimes.remote block below (namespace, gke) is silently ignored.
  remote:
    runtime: remote
server:
  mode: hosted
  hub:
    port: 8080
    public_url: ${public_url}
    hub_id: ${hub_name}
    admin_emails: ${jsonencode(admin_emails)}
  database:
    driver: postgres
    url: postgres://${db_user}:${urlencode(db_password)}@/${db_name}?host=/cloudsql/${sql_connection_name}
    max_open_conns: 10
    max_idle_conns: 5
    conn_max_idle_time: 5m
  storage:
    provider: gcs
    bucket: ${bucket}
  secrets:
    backend: gcpsm
    gcp_project_id: ${project_id}
  auth:
    mode: proxy
    proxy:
      provider: iap
      iap:
        audience: ${iap_audience}
    transport:
      mode: iap
      oidc_audience: ${iap_oauth_client_id}
      platform_auth_sa: ${transport_sa_email}
  oidc:
    enabled: true
    token_lifetime: 15m
  broker:
    enabled: true
    port: 9800
    host: 127.0.0.1
    broker_id: ${hub_name}-broker
    auto_provide: true
  workspace_storage:
    backend: nfs
    nfs:
      mount_root: ${nfs_mount_root}
      uid: ${nfs_uid}
      gid: ${nfs_gid}
      subpath_root: ${nfs_subpath_root}
      shares: ${jsonencode([{ id = hub_name, server = nfs_server, export = nfs_export, pv_name = pv_name }])}
runtimes:
  remote:
    type: kubernetes
    # false is deliberate (design §3.4 agent SA): true would build a
    # SecretProviderClass that the agent SA can no longer read (no Secret
    # Manager role at all, to close the cross-hub signing-key escalation
    # vm-deploy found). Autopilot scheduling tolerance is auto-detected
    # regardless (GKEAutoDetected), so nothing else depends on this being true.
    gke: false
    namespace: ${namespace}
